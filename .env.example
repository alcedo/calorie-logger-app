# Preferred: no env var needed. Sign in once with:
#   claude auth login
# That uses your Claude Pro/Max subscription. Do not set ANTHROPIC_API_KEY.

# Fallback for headless servers and Vercel (does not refresh; lasts one year):
# CLAUDE_CODE_OAUTH_TOKEN=

# Optional ChatGPT subscription. Sign in with `codex login`, or set this JSON
# on Vercel: { "accessToken", "refreshToken", "accountId" }.
# CODEX_AUTH_JSON=

# Provider selection: auto (default: claude, then codex) | claude | codex | openai | none
# Local auto never selects openai. It spends money on an API key.
# On Vercel, auto uses a Claude setup-token or ChatGPT login over HTTP, then OPENAI_API_KEY.
# AI_PROVIDER=auto

# Optional model overrides used when the in-app picker has not saved a choice.
# AI_CLAUDE_MODEL=haiku
# AI_CODEX_MODEL=
# OPENAI_MODEL=gpt-4o-mini

# Optional USDA FoodData Central key (nutrition web search). Falls back to DEMO_KEY.
# USDA_API_KEY=

# CLI subprocess timeout in ms (minimum 20000; default 60000)
# AI_CLI_TIMEOUT_MS=60000

# Paid opt-in. Local auto never selects it. Vercel fallback after subscription tokens.
# OPENAI_API_KEY=
