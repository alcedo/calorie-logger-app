# Google sign-in (required to use the app).
# AUTH_SECRET must be at least 32 characters.
# AUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Preferred: each signed-in user connects Claude from the AI page.
# Do not set ANTHROPIC_API_KEY.

# Per-user Claude setup-token is stored in that user's database, not here.
# AUTH_TEST_MINT=1 is for Vitest and Playwright only. Never set it in production.

# Optional ChatGPT subscription. Sign in with `codex login` (no env var needed).

# Provider selection: auto (default: claude, then codex) | claude | codex | openai | none
# openai is never auto-selected — it spends money on an API key.
# AI_PROVIDER=auto

# Optional model overrides used when the in-app picker has not saved a choice.
# AI_CLAUDE_MODEL=haiku
# AI_CODEX_MODEL=
# OPENAI_MODEL=gpt-4o-mini

# Optional USDA FoodData Central key (nutrition web search). Falls back to DEMO_KEY.
# USDA_API_KEY=

# CLI subprocess timeout in ms (minimum 20000; default 60000)
# AI_CLI_TIMEOUT_MS=60000

# Paid opt-in only. Never auto-selected. Requires AI_PROVIDER=openai.
# OPENAI_API_KEY=
